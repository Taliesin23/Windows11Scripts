# Windows 11 CyberPatriots Security Hardening Script
# Requires Administrative Privileges
# Last Updated: 2025

# =======================
# Elevation Check
# =======================
If (-NOT ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Warning "This script must be run as Administrator. Exiting."
    Read-Host "Press Enter to exit"
    exit 1
}

# =======================
# Start Logging
# =======================
$logPath = "C:\CyberPatriots_Logs"
if (-not (Test-Path $logPath)) {
    New-Item -Path $logPath -ItemType Directory -Force | Out-Null
}
$logFile = "$logPath\SecurityHardening_$(Get-Date -Format yyyyMMdd_HHmmss).log"
Start-Transcript -Path $logFile

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Windows 11 CyberPatriots Hardening Script" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host ""

# =======================
# Password Policy (Local)
# =======================
Write-Host "[*] Configuring password policies..." -ForegroundColor Yellow

$securityPolicies = @{
    "uniquepw" = 5      # Password history
    "maxpwage" = 60     # Maximum password age (days) - adjusted for Windows 11
    "minpwage" = 1      # Minimum password age (days)
    "minpwlen" = 14     # Minimum password length (14 recommended)
}

foreach ($policy in $securityPolicies.Keys) {
    $command = "net accounts /$policy:$($securityPolicies[$policy])"
    Write-Host "  Applying: $command"
    Start-Process cmd.exe -ArgumentList "/c $command" -Wait -NoNewWindow -RedirectStandardError "$logPath\errors.txt"
}
Write-Host "[✓] Password policies configured." -ForegroundColor Green

# =======================
# Account Lockout Policy
# =======================
Write-Host "[*] Configuring lockout policies..." -ForegroundColor Yellow

$lockoutPolicies = @{
    "lockoutthreshold" = 5
    "lockoutduration" = 30
    "lockoutwindow" = 30
}

foreach ($policy in $lockoutPolicies.Keys) {
    $command = "net accounts /$policy:$($lockoutPolicies[$policy])"
    Write-Host "  Applying: $command"
    Start-Process cmd.exe -ArgumentList "/c $command" -Wait -NoNewWindow
}
Write-Host "[✓] Lockout policies configured." -ForegroundColor Green

# =======================
# Audit Logging Configuration
# =======================
Write-Host "[*] Enabling comprehensive audit logging..." -ForegroundColor Yellow

$auditCategories = @(
    "Logon/Logoff",
    "Account Logon",
    "Account Management",
    "Policy Change",
    "Privilege Use",
    "System",
    "Object Access",
    "Detailed Tracking"
)

foreach ($category in $auditCategories) {
    try {
        $result = auditpol /set /category:"$category" /success:enable /failure:enable 2>&1
        Write-Host "  ✓ Enabled: $category"
    } catch {
        Write-Warning "  ✗ Failed: $category"
    }
}
Write-Host "[✓] Audit logging enabled." -ForegroundColor Green

# =======================
# Disable Unnecessary Accounts
# =======================
Write-Host "[*] Securing local accounts..." -ForegroundColor Yellow

# Disable Guest account
Try {
    $guest = Get-LocalUser -Name "Guest" -ErrorAction SilentlyContinue
    if ($guest -and $guest.Enabled) {
        Disable-LocalUser -Name "Guest" -ErrorAction Stop
        Write-Host "  ✓ Guest account disabled."
    } else {
        Write-Host "  - Guest account already disabled or not found."
    }
} Catch {
    Write-Warning "  ✗ Failed to disable Guest account."
}

# Rename Administrator account (CyberPatriots best practice)
Try {
    $adminAccount = Get-LocalUser | Where-Object { $_.SID.Value -like "*-500" }
    if ($adminAccount -and $adminAccount.Name -eq "Administrator") {
        Rename-LocalUser -Name "Administrator" -NewName "CP_Admin"
        Write-Host "  ✓ Administrator account renamed to CP_Admin."
    }
} Catch {
    Write-Warning "  ✗ Could not rename Administrator account."
}

Write-Host "[✓] Account security configured." -ForegroundColor Green

# =======================
# Windows Update Configuration
# =======================
Write-Host "[*] Configuring Windows Update..." -ForegroundColor Yellow

Try {
    $auPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU"
    if (-not (Test-Path $auPath)) {
        New-Item -Path $auPath -Force | Out-Null
    }
    
    Set-ItemProperty -Path $auPath -Name "NoAutoUpdate" -Value 0 -Type DWord
    Set-ItemProperty -Path $auPath -Name "AUOptions" -Value 4 -Type DWord
    Set-ItemProperty -Path $auPath -Name "ScheduledInstallDay" -Value 0 -Type DWord
    Set-ItemProperty -Path $auPath -Name "ScheduledInstallTime" -Value 3 -Type DWord
    
    # Also configure using Windows 11 method
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update" -Name "AUOptions" -Value 4 -Type DWord -ErrorAction SilentlyContinue
    
    Write-Host "  ✓ Automatic updates enabled."
} Catch {
    Write-Warning "  ✗ Failed to configure Windows Update."
}
Write-Host "[✓] Windows Update configured." -ForegroundColor Green

# =======================
# Windows Defender Configuration
# =======================
Write-Host "[*] Hardening Windows Defender..." -ForegroundColor Yellow

Try {
    Set-MpPreference -DisableRealtimeMonitoring $false
    Set-MpPreference -SubmitSamplesConsent 2
    Set-MpPreference -MAPSReporting 2
    Set-MpPreference -PUAProtection 1
    Set-MpPreference -DisableBlockAtFirstSeen $false
    Set-MpPreference -CloudBlockLevel 2
    Set-MpPreference -CloudExtendedTimeout 50
    
    # Update signatures
    Update-MpSignature -ErrorAction SilentlyContinue
    
    Write-Host "  ✓ Windows Defender configured and updated."
} Catch {
    Write-Warning "  ✗ Failed to configure Windows Defender."
}
Write-Host "[✓] Windows Defender hardened." -ForegroundColor Green

# =======================
# Firewall Configuration
# =======================
Write-Host "[*] Configuring Windows Firewall..." -ForegroundColor Yellow

# Enable firewall for all profiles
Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True
Write-Host "  ✓ Firewall enabled for all profiles."

# Disable risky firewall rules
$riskyRules = @(
    "*Remote Assistance (DCOM-In)*",
    "*Remote Assistance (PNRP-In)*",
    "*Remote Assistance (RA Server TCP-In)*",
    "*Remote Assistance (SSDP TCP-In)*",
    "*Remote Assistance (SSDP UDP-In)*",
    "*Remote Assistance (TCP-In)*",
    "*Remote Assistance*",
    "*Telnet*",
    "*FTP*",
    "*TFTP*",
    "*netcat*"
)

foreach ($pattern in $riskyRules) {
    $rules = Get-NetFirewallRule | Where-Object { $_.DisplayName -like $pattern -and $_.Enabled -eq $true }
    foreach ($rule in $rules) {
        try {
            Disable-NetFirewallRule -Name $rule.Name -ErrorAction Stop
            Write-Host "  ✓ Disabled: $($rule.DisplayName)"
        } catch {
            Write-Warning "  ✗ Could not disable: $($rule.DisplayName)"
        }
    }
}
Write-Host "[✓] Firewall configured." -ForegroundColor Green

# =======================
# Disable Unnecessary Services
# =======================
Write-Host "[*] Disabling unnecessary services..." -ForegroundColor Yellow

$servicesToDisable = @(
    "RemoteRegistry",           # Remote Registry
    "RemoteAccess",            # Remote Access
    "Telephony",               # Telephony
    "TlntSvr",                 # Telnet Server
    "FTPSVC",                  # FTP Service
    "SSDPSRV",                 # SSDP Discovery
    "upnphost",                # UPnP Device Host
    "WMPNetworkSvc",           # Windows Media Player Network Sharing
    "XblAuthManager",          # Xbox Live Auth Manager
    "XblGameSave",             # Xbox Live Game Save
    "XboxNetApiSvc",           # Xbox Networking Service
    "XboxGipSvc",              # Xbox Accessory Management
    "bthserv",                 # Bluetooth Support Service
    "Bonjour Service",         # Bonjour Service
    "MSFTPSVC",                # Microsoft FTP Service
    "mnmsrvc",                 # NetMeeting Remote Desktop Sharing
    "Spooler",                 # Print Spooler (DISABLE ONLY IF NOT NEEDED)
    "RasAuto",                 # Remote Access Auto Connection Manager
    "RasMan",                  # Remote Access Connection Manager
    # NOTE: Remote Desktop Services (TermService, SessionEnv, UmRdpService) NOT disabled
    # Many competitions require RDP access - check README before disabling
    "RpcLocator",              # Remote Procedure Call (RPC) Locator
    "IISADMIN",                # IIS Admin Service
    "simptcp",                 # Simple TCP/IP Services
    "SNMPTRAP",                # SNMP Trap
    "LanmanServer",            # Server (if not needed)
    "NetTcpPortSharing",       # Net.Tcp Port Sharing Service
    "W3SVC",                   # World Wide Web Publishing Service
    "WlanSvc"                  # WLAN AutoConfig (disable if not using WiFi)
)

foreach ($svc in $servicesToDisable) {
    $service = Get-Service -Name $svc -ErrorAction SilentlyContinue
    if ($service) {
        try {
            if ($service.Status -eq 'Running') {
                Stop-Service -Name $svc -Force -ErrorAction Stop
            }
            Set-Service -Name $svc -StartupType Disabled -ErrorAction Stop
            Write-Host "  ✓ Disabled: $svc"
        } catch {
            Write-Warning "  ✗ Could not disable: $svc"
        }
    }
}

# Enable critical services
Write-Host "[*] Ensuring critical services are enabled..." -ForegroundColor Yellow

$criticalServices = @{
    "EventLog" = "Automatic"        # Windows Event Log
    "wuauserv" = "Automatic"        # Windows Update
    "mpssvc" = "Automatic"          # Windows Defender Firewall
    "WinDefend" = "Automatic"       # Windows Defender Antivirus
    "Sense" = "Manual"              # Windows Defender Advanced Threat Protection
    "WdNisSvc" = "Manual"           # Windows Defender Network Inspection Service
}

foreach ($svc in $criticalServices.Keys) {
    $service = Get-Service -Name $svc -ErrorAction SilentlyContinue
    if ($service) {
        try {
            Set-Service -Name $svc -StartupType $criticalServices[$svc] -ErrorAction Stop
            if ($criticalServices[$svc] -eq "Automatic" -and $service.Status -ne 'Running') {
                Start-Service -Name $svc -ErrorAction Stop
            }
            Write-Host "  ✓ Enabled: $svc ($($criticalServices[$svc]))"
        } catch {
            Write-Warning "  ✗ Could not configure: $svc"
        }
    }
}

Write-Host "[✓] Service configuration complete." -ForegroundColor Green

# =======================
# Local Security Policy Settings
# =======================
Write-Host "[*] Applying Local Security Policy settings..." -ForegroundColor Yellow

# Create temporary security policy file
Try {
    $secpolPath = "$env:TEMP\secpol.cfg"
    secedit /export /cfg $secpolPath /quiet | Out-Null

    $secpolContent = Get-Content $secpolPath

    # Modify security policy settings
    $secpolContent = $secpolContent -replace 'LimitBlankPasswordUse = 0', 'LimitBlankPasswordUse = 1'
    $secpolContent = $secpolContent -replace 'ClearPageFileAtShutdown = 0', 'ClearPageFileAtShutdown = 1'

    # Write modified content back
    $secpolContent | Set-Content $secpolPath

    # Apply the modified policy
    secedit /configure /db secedit.sdb /cfg $secpolPath /areas SECURITYPOLICY /quiet | Out-Null
    Remove-Item $secpolPath -Force -ErrorAction SilentlyContinue
} Catch {
    Write-Warning "  ✗ Failed to configure some security policies via secedit."
}

Write-Host "  ✓ Blank password use restricted."
Write-Host "  ✓ Virtual memory pagefile clearing enabled."

# Additional LSA settings
# Additional LSA settings
Try {
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "LimitBlankPasswordUse" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "NoLMHash" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "RestrictAnonymousSAM" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "RestrictAnonymous" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "EveryoneIncludesAnonymous" -Value 0 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "DisableDomainCreds" -Value 1 -Type DWord -Force
    Write-Host "  ✓ LSA security settings configured."
} Catch {
    Write-Warning "  ✗ Failed to configure some LSA settings."
}

# Don't display last username
Try {
    if (-not (Test-Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System")) {
        New-Item -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "DontDisplayLastUserName" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "DisableCAD" -Value 0 -Type DWord -Force
    Write-Host "  ✓ Interactive logon policies configured."
} Catch {
    Write-Warning "  ✗ Failed to configure interactive logon policies."
}

# SMB Client/Server Signing
# SMB Client/Server Signing
Try {
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters" -Name "RequireSecuritySignature" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters" -Name "EnableSecuritySignature" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters" -Name "EnablePlainTextPassword" -Value 0 -Type DWord -Force

    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" -Name "RequireSecuritySignature" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" -Name "EnableSecuritySignature" -Value 1 -Type DWord -Force
    Write-Host "  ✓ SMB signing enabled (client and server)."
} Catch {
    Write-Warning "  ✗ Failed to configure SMB signing."
}

# LDAP Server Signing (if applicable)
Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\NTDS\Parameters" -Name "LDAPServerIntegrity" -Value 2 -Type DWord -Force -ErrorAction SilentlyContinue

# Network access policies
# Network access policies
Try {
    if (-not (Test-Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0")) {
        New-Item -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0" -Name "NTLMMinClientSec" -Value 537395200 -Type DWord -Force
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0" -Name "NTLMMinServerSec" -Value 537395200 -Type DWord -Force
    Write-Host "  ✓ Network access policies configured."
} Catch {
    Write-Warning "  ✗ Failed to configure network access policies."
}

Write-Host "[✓] Local Security Policy settings applied." -ForegroundColor Green

# =======================
# Registry Security Settings
# =======================
Write-Host "[*] Applying registry security settings..." -ForegroundColor Yellow

# Disable AutoRun/AutoPlay
# Disable AutoRun/AutoPlay
Try {
    if (-not (Test-Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer")) {
        New-Item -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" -Name "NoDriveTypeAutoRun" -Value 255 -Type DWord -Force
    Write-Host "  ✓ AutoRun disabled."
} Catch {
    Write-Warning "  ✗ Failed to disable AutoRun."
}

# Restrict CD-ROM and Floppy access
# Restrict CD-ROM and Floppy access
Try {
    if (-not (Test-Path "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon")) {
        New-Item -Path "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" -Name "AllocateCDRoms" -Value "1" -Type String -Force
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" -Name "AllocateFloppies" -Value "1" -Type String -Force
    Write-Host "  ✓ CD-ROM and Floppy access restricted to logged-on user."
} Catch {
    Write-Warning "  ✗ Failed to restrict CD-ROM/Floppy access."
}

# Enable SmartScreen
# Enable SmartScreen
Try {
    if (-not (Test-Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System")) {
        New-Item -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System" -Name "EnableSmartScreen" -Value 1 -Type DWord -Force
    Write-Host "  ✓ SmartScreen enabled."
} Catch {
    Write-Warning "  ✗ Failed to enable SmartScreen."
}

# Disable LLMNR
# Disable LLMNR
Try {
    if (-not (Test-Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient")) {
        New-Item -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient" -Name "EnableMulticast" -Value 0 -Type DWord -Force
    Write-Host "  ✓ LLMNR disabled."
} Catch {
    Write-Warning "  ✗ Failed to disable LLMNR."
}

# Disable NetBIOS over TCP/IP
Try {
    $adapters = Get-WmiObject Win32_NetworkAdapterConfiguration -ErrorAction Stop | Where-Object { $_.IPEnabled -eq $true }
    foreach ($adapter in $adapters) {
        $adapter.SetTcpipNetbios(2) | Out-Null
    }
    Write-Host "  ✓ NetBIOS over TCP/IP disabled."
} Catch {
    Write-Warning "  ✗ Could not disable NetBIOS over TCP/IP."
}

Write-Host "[✓] Registry security settings applied." -ForegroundColor Green

# =======================
# Enable Advanced Security Features
# =======================
Write-Host "[*] Enabling Windows 11 security features..." -ForegroundColor Yellow

# Enable Credential Guard (Windows 11 Pro+)
Try {
    $vbs = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction SilentlyContinue
    if ($vbs) {
        # Enable VBS and Credential Guard
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard" -Name "EnableVirtualizationBasedSecurity" -Value 1 -Type DWord -Force
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "LsaCfgFlags" -Value 1 -Type DWord -Force
        Write-Host "  ✓ Credential Guard enabled (requires reboot)."
    }
} Catch {
    Write-Warning "  - Credential Guard configuration skipped."
}

# Enable Windows Defender Application Guard
Try {
    $wdag = Get-WindowsOptionalFeature -Online -FeatureName Windows-Defender-ApplicationGuard -ErrorAction SilentlyContinue
    if ($wdag -and $wdag.State -ne "Enabled") {
        Enable-WindowsOptionalFeature -Online -FeatureName Windows-Defender-ApplicationGuard -NoRestart -ErrorAction Stop
        Write-Host "  ✓ Application Guard enabled."
    }
} Catch {
    Write-Warning "  - Application Guard not available on this system."
}

Write-Host "[✓] Advanced security features configured." -ForegroundColor Green

# =======================
# User Account Audit
# =======================
Write-Host "[*] Auditing user accounts..." -ForegroundColor Yellow

$users = Get-LocalUser | Where-Object { $_.Enabled -eq $true }
Write-Host "  Active Local Users:" -ForegroundColor Cyan
foreach ($user in $users) {
    Try {
        $userGroups = @()
        $allGroups = Get-LocalGroup
        foreach ($group in $allGroups) {
            $members = Get-LocalGroupMember -Group $group.Name -ErrorAction SilentlyContinue
            if ($members.Name -contains "$env:COMPUTERNAME\$($user.Name)") {
                $userGroups += $group.Name
            }
        }
        $groupList = if ($userGroups.Count -gt 0) { $userGroups -join ", " } else { "None" }
        Write-Host "    - $($user.Name) | Groups: $groupList"
    } Catch {
        Write-Host "    - $($user.Name) | Groups: Unable to determine"
    }
}

Try {
    $admins = Get-LocalGroupMember -Group "Administrators" -ErrorAction Stop
    Write-Host "  Administrators:" -ForegroundColor Cyan
    foreach ($admin in $admins) {
        Write-Host "    - $($admin.Name)"
    }
} Catch {
    Write-Warning "  ✗ Could not enumerate Administrators group."
}

Write-Host "[✓] User audit complete." -ForegroundColor Green

