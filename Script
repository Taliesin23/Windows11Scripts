# Windows 10 Security Hardening Script
# Requires Administrative Privileges

# =======================
# Elevation Check
# =======================
If (-NOT ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Warning "This script must be run as Administrator. Exiting."
    exit 1
}

# =======================
# Start Logging
# =======================
$logPath = "C:\Logs"
if (-not (Test-Path $logPath)) {
    New-Item -Path $logPath -ItemType Directory -Force
}
$logFile = "$logPath\SecurityHardening_$(Get-Date -Format yyyyMMdd_HHmmss).log"
Start-Transcript -Path $logFile

# =======================
# Password Policy (Local)
# =======================
Write-Host "Configuring password policies..."

$securityPolicies = @{
    "uniquepw" = 5 # Password history
    "maxpwage" = 30 # Maximum password age (days)
    "minpwage" = 10 # Minimum password age (days)
    "minpwlen" = 12 # Minimum password length
}

foreach ($policy in $securityPolicies.Keys) {
    $command = "net accounts /$policy:$($securityPolicies[$policy])"
    Write-Host "Applying: $command"
    Start-Process cmd.exe -ArgumentList "/c $command" -Wait -NoNewWindow
}

# =======================
# Advanced Account Lockout Policy
# =======================
Write-Host "Configuring lockout policies..."

$lockoutPolicies = @{
    "lockoutthreshold" = 5
    "lockoutduration" = 30
    "lockoutwindow" = 30
}

foreach ($policy in $lockoutPolicies.Keys) {
    $command = "net accounts /$policy:$($lockoutPolicies[$policy])"
    Write-Host "Applying: $command"
    Start-Process cmd.exe -ArgumentList "/c $command" -Wait -NoNewWindow
}

# =======================
# Audit Logging Configuration
# =======================
Write-Host "Enabling audit logging..."

$auditCategories = @(
    "Account Logon",
    "Account Management",
    "Detailed Tracking",
    "DS Access",
    "Logon",
    "Object Access",
    "Policy Change",
    "Privilege Use",
    "System"
)

foreach ($category in $auditCategories) {
    try {
        Write-Host "Enabling auditing for: $category"
        Start-Process auditpol -ArgumentList "/set /subcategory:`"$category`" /success:enable /failure:enable" -Wait -NoNewWindow
    } catch {
        Write-Warning "Failed to set audit policy for: $category"
    }
}

# =======================
# Disable Unnecessary Accounts
# =======================
Write-Host "Disabling unnecessary local accounts..."

# Disable Guest account
Try {
    Disable-LocalUser -Name "Guest" -ErrorAction Stop
    Write-Host "Guest account disabled."
} Catch {
    Write-Warning "Failed to disable Guest account."
}

# Disable Administrator only if other admin accounts exist
$otherAdmins = Get-LocalUser | Where-Object { $_.Enabled -and $_.Name -ne "Administrator" } | Where-Object {
    (Get-LocalGroupMember -Group "Administrators").Name -contains $_.Name
}

if ($otherAdmins.Count -gt 0) {
    Try {
        Disable-LocalUser -Name "Administrator" -ErrorAction Stop
        Write-Host "Built-in Administrator account disabled."
    } Catch {
        Write-Warning "Failed to disable Administrator account."
    }
} else {
    Write-Warning "Cannot disable Administrator account: No other local admin accounts exist."
}

# =======================
# Windows Update Configuration (Registry Method)
# =======================
Write-Host "Configuring automatic Windows updates..."

Try {
    # Create registry path if it doesn't exist
    $auPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU"
    if (-not (Test-Path $auPath)) {
        New-Item -Path $auPath -Force | Out-Null
    }
    
    # Disable "No Auto Update"
    Set-ItemProperty -Path $auPath -Name "NoAutoUpdate" -Value 0 -Type DWord
    
    # Set to automatically download and install (option 4)
    Set-ItemProperty -Path $auPath -Name "AUOptions" -Value 4 -Type DWord
    
    Write-Host "Windows Update configured for automatic updates via registry."
} Catch {
    Write-Warning "Failed to configure Windows Update. Error: $_"
}

# =======================
# Firewall Rule Hardening
# =======================
Write-Host "Disabling unwanted firewall rules..."

$firewallRulesToDisable = @(
    "Remote Assistance",
    "Telnet Server",
    "netcat"
)

foreach ($ruleName in $firewallRulesToDisable) {
    $rules = Get-NetFirewallRule | Where-Object { $_.DisplayName -like "*$ruleName*" }
    if ($rules) {
        foreach ($rule in $rules) {
            try {
                Disable-NetFirewallRule -InputObject $rule -ErrorAction Stop
                Write-Host "Disabled firewall rule: $($rule.DisplayName)"
            } catch {
                Write-Warning "Could not disable firewall rule: $($rule.DisplayName)"
            }
        }
    } else {
        Write-Warning "No firewall rule matching '$ruleName' was found."
    }
}

# =======================
# Windows Defender Hardening
# =======================
Write-Host "Enabling Windows Defender real-time protection..."

Try {
    Set-MpPreference -DisableRealtimeMonitoring $false
    Set-MpPreference -SubmitSamplesConsent 2 # Always send samples
    Set-MpPreference -MAPSReporting 2 # Advanced cloud protection
    Write-Host "Windows Defender settings applied."
} Catch {
    Write-Warning "Failed to configure Windows Defender. Ensure Defender is installed and enabled."
}

# =======================
# Completion
# =======================
Write-Host "Windows 10 Security Hardening Complete." -ForegroundColor Green
Stop-Transcript
