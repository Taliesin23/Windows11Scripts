################################################################################
# 16. WEB SERVER HARDENING
################################################################################

harden_apache() {
    echo "Hardening Apache2..."
    
    if ! command -v apache2 &> /dev/null; then
        echo "Apache2 not installed"
        return
    fi
    
    if [ ! -f /etc/apache2/apache2.conf ]; then
        echo "Apache2 config file not found"
        return
    fi
    
    # Backup config
    sudo cp /etc/apache2/apache2.conf /etc/apache2/apache2.conf.bak
    
    # Check if security settings already exist
    if ! grep -q "CyberPatriot Security Settings" /etc/apache2/apache2.conf; then
        # Add security settings
        cat << 'EOF' | sudo tee -a /etc/apache2/apache2.conf

# CyberPatriot Security Settings
<Directory /var/www/>
    Options -Indexes
</Directory>
ServerTokens Prod
ServerSignature Off
EOF
    else
        echo "Security settings already present in apache2.conf"
    fi
    
    # Disable modules if they exist
    sudo a2dismod status 2>/dev/null || echo "status module not enabled"
    sudo a2dismod autoindex 2>/dev/null || echo "autoindex module not enabled"
    
    # Test configuration before restart
    if sudo apache2ctl configtest 2>&1 | grep -q "Syntax OK"; then
        sudo systemctl restart apache2
        echo "Apache2 hardened and restarted"
    else
        echo "Apache2 configuration test failed, not restarting"
        sudo apache2ctl configtest
    fi
}

harden_samba() {
    echo "Hardening Samba..."
    
    if ! command -v smbd &> /dev/null; then
        echo "Samba not installed"
        return
    fi
    
    if [ ! -f /etc/samba/smb.conf ]; then
        echo "Samba config file not found"
        return
    fi
    
    sudo cp /etc/samba/smb.conf /etc/samba/smb.conf.bak
    
    # Add settings to global section if not present
    if ! grep -q "map to guest" /etc/samba/smb.conf; then
        sudo sed -i '/\[global\]/a \   map to guest = never' /etc/samba/smb.conf
    fi
    
    if ! grep -q "guest ok" /etc/samba/smb.conf; then
        sudo sed -i '/\[global\]/a \   guest ok = no' /etc/samba/smb.conf
    fi
    
    if ! grep -q "server min protocol" /etc/samba/smb.conf; then
        sudo sed -i '/\[global\]/a \   server min protocol = SMB3' /etc/samba/smb.conf
    fi
    
    sudo systemctl restart smbd 2>/dev/null
    sudo systemctl restart nmbd 2>/dev/null
    echo "Samba hardened"
}

harden_vsftpd() {
    echo "Hardening vsftpd..."
    
    if [ ! -f /etc/vsftpd.conf ]; then
        echo "vsftpd not installed"
        return
    fi
    
    sudo cp /etc/vsftpd.conf /etc/vsftpd.conf.bak
    
    sudo sed -i 's/^anonymous_enable=.*/anonymous_enable=NO/' /etc/vsftpd.conf
    sudo sed -i 's/^#*chroot_local_user=.*/chroot_local_user=YES/' /etc/vsftpd.conf
    
    sudo systemctl restart vsftpd
    echo "vsftpd hardened"
}

################################################################################
# 17. EMAIL SERVER (POSTFIX)
################################################################################

harden_postfix() {
    echo "Hardening Postfix..."
    
    if ! command -v postfix &> /dev/null; then
        echo "Postfix not installed"
        return
    fi
    
    sudo cp /etc/postfix/main.cf /etc/postfix/main.cf.bak
    
    sudo postconf -e "inet_interfaces = localhost"
    sudo postconf -e "mynetworks = 127.0.0.0/8"
    
    sudo systemctl restart postfix
    echo "Postfix configured for localhost only"
}

