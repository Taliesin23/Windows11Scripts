################################################################################
# 5. BULK REMOVE FROM SPECIFIC DIRECTORY
################################################################################

bulk_remove_from_directory() {
    read -p "Enter directory path to clean (e.g., /home/user/Downloads): " target_dir
    
    if [ ! -d "$target_dir" ]; then
        echo -e "${RED}Directory does not exist: $target_dir${NC}"
        return
    fi
    
    echo -e "${YELLOW}Searching for media files in: $target_dir${NC}"
    
    # Find all media files in directory
    mapfile -t files < <(sudo find "$target_dir" -type f \( \
        -iname "*.mp3" -o \
        -iname "*.mp4" -o \
        -iname "*.avi" -o \
        -iname "*.mkv" -o \
        -iname "*.wav" -o \
        -iname "*.flac" -o \
        -iname "*.ogg" -o \
        -iname "*.m4a" -o \
        -iname "*.mov" -o \
        -iname "*.wmv" \
    \) -print 2>/dev/null)
    
    if [ ${#files[@]} -eq 0 ]; then
        echo "No media files found in this directory."
        return
    fi
    
    echo "Found ${#files[@]} media files:"
    printf '%s\n' "${files[@]}"
    echo ""
    
    read -p "Delete ALL these files? (yes/no): " confirm
    if [ "$confirm" = "yes" ]; then
        for file in "${files[@]}"; do
            if sudo rm -f "$file"; then
                echo -e "${GREEN}Deleted: $file${NC}"
            else
                echo -e "${RED}Failed to delete: $file${NC}"
            fi
        done
        echo -e "${GREEN}Bulk deletion complete${NC}"
    else
        echo "Operation cancelled"
    fi
}

################################################################################
# 6. FIND GAMES AND PROHIBITED SOFTWARE
################################################################################

find_games_software() {
    echo -e "${YELLOW}=== Finding Games and Prohibited Software ===${NC}"
    echo ""
    
    echo -e "${GREEN}Checking installed game packages...${NC}"
    dpkg -l | grep -i game
    echo ""
    
    echo -e "${GREEN}Checking for common games...${NC}"
    which solitaire 2>/dev/null && echo "Found: solitaire"
    which mahjongg 2>/dev/null && echo "Found: mahjongg"
    which aisleriot 2>/dev/null && echo "Found: aisleriot"
    which gnome-mines 2>/dev/null && echo "Found: gnome-mines"
    echo ""
    
    echo -e "${GREEN}Searching for game executables...${NC}"
    sudo find /usr/games /usr/local/games -type f 2>/dev/null
    echo ""
    
    echo -e "${GREEN}Searching for Windows executables (.exe, .msi)...${NC}"
    sudo find /home /tmp /var/tmp -type f \( -iname "*.exe" -o -iname "*.msi" \) -print 2>/dev/null
}

################################################################################
# 7. REMOVE GAMES (INTERACTIVE)
################################################################################

remove_games() {
    echo -e "${YELLOW}=== Remove Game Packages ===${NC}"
    echo -e "${RED}WARNING: Only remove if games are prohibited in README!${NC}"
    echo ""
    
    # Common game packages
    GAME_PACKAGES=(
        "aisleriot"
        "gnome-mahjongg"
        "gnome-mines"
        "gnome-sudoku"
        "quadrapassel"
        "swell-foop"
        "five-or-more"
        "four-in-a-row"
        "gnome-chess"
        "gnome-nibbles"
        "gnome-robots"
        "gnome-taquin"
        "gnome-tetravex"
        "hitori"
        "iagno"
        "lightsoff"
        "tali"
    )
    
    echo "Checking for installed games..."
    for package in "${GAME_PACKAGES[@]}"; do
        if dpkg -l | grep -q "^ii.*$package"; then
            echo -e "${YELLOW}Found: $package${NC}"
            read -p "Remove $package? (y/n): " choice
            if [ "$choice" = "y" ]; then
                sudo apt remove --purge -y "$package"
                echo -e "${GREEN}Removed: $package${NC}"
            fi
        fi
    done
    
    echo ""
    echo "Cleaning up..."
    sudo apt autoremove -y
}

################################################################################
# 8. FIND HACKING TOOLS
################################################################################

find_hacking_tools() {
    echo -e "${YELLOW}=== Finding Hacking Tools ===${NC}"
    echo -e "${RED}Only remove if unauthorized in README!${NC}"
    echo ""
    
    # Common hacking tools
    HACKING_TOOLS=(
        "nmap"
        "john"
        "hydra"
        "wireshark"
        "zenmap"
        "ophcrack"
        "aircrack-ng"
        "metasploit"
        "sqlmap"
        "nikto"
        "burpsuite"
        "netcat"
        "nc"
    )
    
    echo "Checking for hacking tools..."
    for tool in "${HACKING_TOOLS[@]}"; do
        if command -v "$tool" &> /dev/null; then
            echo -e "${RED}Found: $tool ($(which $tool))${NC}"
        fi
        
        if dpkg -l | grep -q "^ii.*$tool"; then
            echo -e "${RED}Package installed: $tool${NC}"
        fi
    done
}

################################################################################
# 9. REMOVE HACKING TOOLS (INTERACTIVE)
################################################################################

remove_hacking_tools() {
    echo -e "${YELLOW}=== Remove Hacking Tools ===${NC}"
    echo -e "${RED}WARNING: Only remove if unauthorized in README!${NC}"
    echo ""
    
    HACKING_TOOLS=(
        "nmap"
        "john"
        "hydra"
        "wireshark"
        "zenmap"
        "ophcrack"
        "aircrack-ng"
        "metasploit-framework"
    )
    
    for tool in "${HACKING_TOOLS[@]}"; do
        if dpkg -l | grep -q "^ii.*$tool"; then
            echo -e "${YELLOW}Found package: $tool${NC}"
            read -p "Remove $tool? (y/n): " choice
            if [ "$choice" = "y" ]; then
                sudo apt remove --purge -y "$tool"
                echo -e "${GREEN}Removed: $tool${NC}"
            fi
        fi
    done
    
    sudo apt autoremove -y
}

################################################################################
# 10. SEARCH FOR INAPPROPRIATE CONTENT
################################################################################

search_inappropriate_content() {
    echo -e "${YELLOW}=== Searching for Potentially Inappropriate Content ===${NC}"
    echo "Checking filenames for suspicious keywords..."
    echo ""
    
    # Keywords that might indicate inappropriate content
    KEYWORDS=(
        "hack"
        "crack"
        "keygen"
        "warez"
        "torrent"
        "pirate"
    )
    
    for keyword in "${KEYWORDS[@]}"; do
        echo -e "${GREEN}Searching for: *$keyword*${NC}"
        sudo find /home -type f -iname "*$keyword*" 2>/dev/null
    done
}

################################################################################
# 11. COMPREHENSIVE CLEANUP
################################################################################

comprehensive_cleanup() {
    echo -e "${YELLOW}=== Comprehensive Media Cleanup ===${NC}"
    echo -e "${RED}This will search and optionally remove all prohibited content${NC}"
    echo ""
    
    read -p "Continue? (yes/no): " confirm
    if [ "$confirm" != "yes" ]; then
        echo "Operation cancelled"
        return
    fi
    
    echo ""
    echo "Step 1: Finding all media files..."
    find_all_media
    
    echo ""
    echo "Step 2: Finding games and prohibited software..."
    find_games_software
    
    echo ""
    echo "Step 3: Finding hacking tools..."
    find_hacking_tools
    
    echo ""
    echo -e "${GREEN}Scan complete. Review the results above.${NC}"
    echo "Use the interactive removal functions to delete specific files."
}

################################################################################
# MAIN MENU
################################################################################

show_menu() {
    echo ""
    echo "========================================"
    echo "  Prohibited Media Removal Tool"
    echo "========================================"
    echo "1.  Find All Media Files (saves to /tmp)"
    echo "2.  Search User Directories"
    echo "3.  Remove Audio Files (Interactive)"
    echo "4.  Remove Video Files (Interactive)"
    echo "5.  Bulk Remove from Directory"
    echo "6.  Find Games and Software"
    echo "7.  Remove Games (Interactive)"
    echo "8.  Find Hacking Tools"
    echo "9.  Remove Hacking Tools (Interactive)"
    echo "10. Search for Inappropriate Content"
    echo "11. Comprehensive Cleanup (All Steps)"
    echo "0.  Exit"
    echo "========================================"
}

# Main loop
while true; do
    show_menu
    read -p "Select option: " choice
    
    case $choice in
        1) find_all_media ;;
        2) search_user_directories ;;
        3) remove_audio_interactive ;;
        4) remove_video_interactive ;;
        5) bulk_remove_from_directory ;;
        6) find_games_software ;;
        7) remove_games ;;
        8) find_hacking_tools ;;
        9) remove_hacking_tools ;;
        10) search_inappropriate_content ;;
        11) comprehensive_cleanup ;;
        0) echo "Exiting..."; exit 0 ;;
        *) echo -e "${RED}Invalid option${NC}" ;;
    esac
    
    read -p "Press Enter to continue..."
done
