#!/bin/bash

################################################################################
# CyberPatriot - Prohibited Media Files Removal Scripts
# Use these to find and remove unauthorized media files
################################################################################

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

################################################################################
# 1. FIND AND LIST ALL MEDIA FILES
################################################################################

find_all_media() {
    echo -e "${YELLOW}=== Finding All Media Files ===${NC}"
    echo "This may take several minutes..."
    echo ""
    
    # Create temporary files for results
    AUDIO_FILE="/tmp/audio_files.txt"
    VIDEO_FILE="/tmp/video_files.txt"
    IMAGE_FILE="/tmp/image_files.txt"
    
    echo -e "${GREEN}Searching for audio files...${NC}"
    sudo find / -type f \( \
        -iname "*.mp3" -o \
        -iname "*.wav" -o \
        -iname "*.flac" -o \
        -iname "*.aac" -o \
        -iname "*.ogg" -o \
        -iname "*.m4a" -o \
        -iname "*.wma" \
    \) -print 2>/dev/null | tee "$AUDIO_FILE"
    
    echo ""
    echo -e "${GREEN}Searching for video files...${NC}"
    sudo find / -type f \( \
        -iname "*.mp4" -o \
        -iname "*.avi" -o \
        -iname "*.mkv" -o \
        -iname "*.mov" -o \
        -iname "*.wmv" -o \
        -iname "*.flv" -o \
        -iname "*.mpeg" -o \
        -iname "*.mpg" -o \
        -iname "*.m4v" \
    \) -print 2>/dev/null | tee "$VIDEO_FILE"
    
    echo ""
    echo -e "${GREEN}Searching for image files (in suspicious locations)...${NC}"
    sudo find /tmp /var/tmp /home -type f \( \
        -iname "*.jpg" -o \
        -iname "*.jpeg" -o \
        -iname "*.png" -o \
        -iname "*.gif" -o \
        -iname "*.bmp" \
    \) -print 2>/dev/null | tee "$IMAGE_FILE"
    
    echo ""
    echo -e "${YELLOW}Results saved to:${NC}"
    echo "  Audio: $AUDIO_FILE"
    echo "  Video: $VIDEO_FILE"
    echo "  Images: $IMAGE_FILE"
    echo ""
    echo -e "${YELLOW}Summary:${NC}"
    echo "  Audio files found: $(wc -l < "$AUDIO_FILE")"
    echo "  Video files found: $(wc -l < "$VIDEO_FILE")"
    echo "  Image files found: $(wc -l < "$IMAGE_FILE")"
}

################################################################################
# 2. SEARCH COMMON USER DIRECTORIES
################################################################################

search_user_directories() {
    echo -e "${YELLOW}=== Searching User Directories for Media ===${NC}"
    echo ""
    
    # Common directories where prohibited files are hidden
    DIRS_TO_CHECK=(
        "/home/*/Downloads"
        "/home/*/Music"
        "/home/*/Videos"
        "/home/*/Pictures"
        "/home/*/Desktop"
        "/home/*/Documents"
        "/tmp"
        "/var/tmp"
    )
    
    for dir_pattern in "${DIRS_TO_CHECK[@]}"; do
        echo -e "${GREEN}Checking: $dir_pattern${NC}"
        
        # Expand the pattern and check each directory
        for dir in $dir_pattern; do
            if [ -d "$dir" ]; then
                echo "  Scanning $dir..."
                sudo find "$dir" -type f \( \
                    -iname "*.mp3" -o \
                    -iname "*.mp4" -o \
                    -iname "*.avi" -o \
                    -iname "*.mkv" -o \
                    -iname "*.wav" -o \
                    -iname "*.flac" \
                \) -ls 2>/dev/null
            fi
        done
        echo ""
    done
}

################################################################################
# 3. REMOVE AUDIO FILES (INTERACTIVE)
################################################################################

remove_audio_interactive() {
    echo -e "${YELLOW}=== Remove Audio Files (Interactive) ===${NC}"
    echo -e "${RED}WARNING: This will permanently delete files!${NC}"
    echo ""
    
    # Find audio files
    mapfile -t audio_files < <(sudo find / -type f \( \
        -iname "*.mp3" -o \
        -iname "*.wav" -o \
        -iname "*.flac" -o \
        -iname "*.aac" -o \
        -iname "*.ogg" -o \
        -iname "*.m4a" -o \
        -iname "*.wma" \
    \) -print 2>/dev/null)
    
    if [ ${#audio_files[@]} -eq 0 ]; then
        echo "No audio files found."
        return
    fi
    
    echo "Found ${#audio_files[@]} audio files"
    echo ""
    
    for file in "${audio_files[@]}"; do
        echo -e "${YELLOW}File: $file${NC}"
        
        # Show file details
        ls -lh "$file" 2>/dev/null
        
        read -p "Delete this file? (y/n/q to quit): " choice
        case "$choice" in
            y|Y)
                if sudo rm -f "$file"; then
                    echo -e "${GREEN}Deleted: $file${NC}"
                else
                    echo -e "${RED}Failed to delete: $file${NC}"
                fi
                ;;
            q|Q)
                echo "Quitting..."
                return
                ;;
            *)
                echo "Skipped"
                ;;
        esac
        echo ""
    done
}

